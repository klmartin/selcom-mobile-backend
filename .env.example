# Run npm run setup to create .env and generate APP_API_KEY.
NODE_ENV=production
HOST=127.0.0.1
PORT=3080
APP_API_KEY=
# Keep 0 when connecting directly. Set to 1 only behind ONE trusted local proxy.
TRUST_PROXY_HOPS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=selcom_payments
DB_USER=selcom_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
# Optional verified CA file for a remote MySQL TLS connection.
DB_SSL_CA_FILE=

# Obtain the HTTPS origin/base URL from Selcom. Do not append /v1/checkout.
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
PUBLIC_WEBHOOK_URL=https://YOUR-DOMAIN.example/api/v1/webhooks/selcom
SELCOM_TIMEOUT_MS=20000
PAYMENT_MIN_AMOUNT=100
PAYMENT_MAX_AMOUNT=10000000

# Successful callbacks are persisted, acknowledged, then verified by this worker.
RECONCILE_ENABLED=true
RECONCILE_POLL_MS=15000
RECONCILE_INITIAL_DELAY_MS=180000
RECONCILE_INTERVAL_MS=180000
RECONCILE_MAX_ATTEMPTS=20
RECONCILE_BATCH_SIZE=10
# Agree this window with Selcom if retries retain an old signed timestamp.
WEBHOOK_MAX_SKEW_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_MAX=240
JSON_BODY_LIMIT=64kb
